{
  "rewrites": [
    {
      "source": "/:section(characters|events|projection|visualization|hologram|drone-shows|drawings-illustrations|contact|social)/:slug",
      "destination": "/:section/:slug/index.html"
    },
    {
      "source": "/:section(characters|events|projection|visualization|hologram|drone-shows|drawings-illustrations|contact|social)",
      "destination": "/:section/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
